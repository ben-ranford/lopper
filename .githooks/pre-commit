#!/usr/bin/env sh
set -eu

# Git runs hooks with repository-location variables set. Clearing them lets
# nested git commands rediscover the current worktree instead of leaking the
# hook context into child processes. Keep GIT_INDEX_FILE: partial commits use
# it to identify the exact content being committed.
unset GIT_DIR GIT_WORK_TREE GIT_PREFIX

# Some linked-worktree setups inherit shared Git config with core.bare=true.
# Append a worktree-mode override without discarding caller runtime config.
git_config_count=${GIT_CONFIG_COUNT:-0}
case "$git_config_count" in
	''|*[!0-9]*)
		echo "[pre-commit] invalid GIT_CONFIG_COUNT: $git_config_count" >&2
		exit 1
		;;
esac
export "GIT_CONFIG_KEY_${git_config_count}=core.bare"
export "GIT_CONFIG_VALUE_${git_config_count}=false"
export GIT_CONFIG_COUNT=$((git_config_count + 1))

echo "[pre-commit] running make fmt"
make fmt

echo "[pre-commit] running make ci (module, lint, workflow, shell, duplication, inline suppressions, security, vuln, test, goleak, race, memory delta, build, coverage checks)"
make ci

echo "[pre-commit] checks passed"
