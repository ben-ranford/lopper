#!/bin/sh
set -eu

unset GIT_DIR GIT_WORK_TREE GIT_PREFIX

config_count=${GIT_CONFIG_COUNT:-0}
case "$config_count" in ''|*[!0-9]*) exit 1 ;; esac
while [ "${config_count#0}" != "$config_count" ]; do config_count=${config_count#0}; done
config_count=${config_count:-0}
export "GIT_CONFIG_KEY_${config_count}=core.bare"
export "GIT_CONFIG_VALUE_${config_count}=false"
export GIT_CONFIG_COUNT=$((config_count + 1))

caller_path=${PATH-}
gofmt_bin=$(PATH=$caller_path command -v gofmt) || exit 1
PATH=/usr/bin:/bin:$caller_path
export PATH
checkout_root=$(pwd -P) || exit 1
git_bin=$(command -v git) || exit 1
mktemp_bin=$(command -v mktemp) || exit 1
xargs_bin=$(command -v xargs) || exit 1
case "$gofmt_bin" in /*) ;; *) echo "Refusing unresolved hook tool: gofmt" >&2; exit 1 ;; esac
gofmt_reference=$gofmt_bin
gofmt_link_depth=0
while [ -L "$gofmt_bin" ]; do
	gofmt_parent=$(CDPATH='' cd -P "$(dirname "$gofmt_bin")" && pwd -P) || exit 1
	gofmt_target=$(readlink "$gofmt_bin") || exit 1
	case "$gofmt_target" in
		/*) gofmt_bin=$gofmt_target ;;
		*) gofmt_bin=$gofmt_parent/$gofmt_target ;;
	esac
	gofmt_link_depth=$((gofmt_link_depth + 1))
	[ "$gofmt_link_depth" -le 40 ] || { echo "Refusing cyclic gofmt symlink: $gofmt_reference" >&2; exit 1; }
done
gofmt_dir=$(CDPATH='' cd -P "$(dirname "$gofmt_bin")" && pwd -P) || exit 1
gofmt_bin=$gofmt_dir/${gofmt_bin##*/}
if [ ! -f "$gofmt_bin" ] || [ ! -x "$gofmt_bin" ]; then
	echo "Refusing non-executable hook tool: gofmt" >&2
	exit 1
fi
case "$gofmt_bin" in "$checkout_root"|"$checkout_root"/*) echo "Refusing checkout-controlled hook tool: gofmt" >&2; exit 1 ;; esac
names_file=$("$mktemp_bin") || exit 1
ci_root=
ci_worktree=
cleanup() {
	rm -f "$names_file"
	if [ -n "$ci_worktree" ]; then
		"$git_bin" -C "$checkout_root" -c core.bare=false worktree remove --force "$ci_worktree" || :
	fi
	if [ -n "$ci_root" ]; then rm -rf "$ci_root"; fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if ! "$git_bin" diff --cached --check --no-ext-diff --no-textconv; then
	echo "[pre-commit] staged whitespace check failed" >&2
	exit 1
fi
"$git_bin" diff --cached --name-only -z --no-ext-diff --no-textconv --diff-filter=ACMRT -- '*.go' >"$names_file"

# shellcheck disable=SC2016
if ! "$xargs_bin" -0 -n 1 sh -c '
		file=${4-}
		[ -n "$file" ] || exit 0
		stage_file=$("$1") || exit 1
		tmp=
		cleanup() { rm -f "$stage_file" "$tmp"; }
		trap cleanup EXIT
		trap "exit 129" HUP
		trap "exit 130" INT
		trap "exit 143" TERM
		"$2" --literal-pathspecs ls-files --stage -- "$file" >"$stage_file" || exit 1
		IFS=" " read -r mode _ <"$stage_file" || exit 1
		case "$mode" in 100644|100755) ;; *) exit 0 ;; esac
		tmp=$("$1") || exit 1
		"$2" show ":./$file" >"$tmp" || exit 1
		status=0
		diff=$("$3" -d "$tmp") || status=$?
		if [ -n "$diff" ]; then
			echo "[pre-commit] staged Go file must be gofmt-formatted: $file" >&2
			printf "%s\\n" "$diff" >&2
			exit 1
		fi
		[ "$status" -eq 0 ] || { echo "[pre-commit] gofmt failed for $file" >&2; exit "$status"; }
	' sh "$mktemp_bin" "$git_bin" "$gofmt_bin" <"$names_file"; then
	exit 1
fi

# Give HEAD-based gates the pending index, without advancing the branch or
# including unstaged edits. commit-tree does not invoke commit hooks.
staged_tree=$("$git_bin" write-tree) || exit 1
set -- "$staged_tree"
if [ "${LOPPER_HOOK_AMEND:-0}" = 1 ]; then
	# Git does not pass --amend to pre-commit; callers opt in explicitly.
	amend_parents=$("$git_bin" show -s --format=%P HEAD) || exit 1
	for parent_commit in $amend_parents; do
		set -- "$@" -p "$parent_commit"
	done
elif parent_commit=$("$git_bin" rev-parse --verify HEAD 2>/dev/null); then
	set -- "$@" -p "$parent_commit"
fi
unset LOPPER_HOOK_AMEND
merge_head_file=$("$git_bin" rev-parse --git-path MERGE_HEAD) || exit 1
if [ -f "$merge_head_file" ]; then
	while IFS= read -r merge_parent; do
		set -- "$@" -p "$merge_parent"
	done < "$merge_head_file"
fi
pending_commit=$(printf '%s\n' 'Pre-commit CI snapshot' | "$git_bin" commit-tree "$@") || exit 1

# Materialize only objects missing from normal repository storage before
# clearing a caller-supplied object database. Do not repack borrowed history.
local_git_env=$("$git_bin" rev-parse --local-env-vars) || exit 1
ci_root=$("$mktemp_bin" -d) || exit 1
if [ -n "${GIT_OBJECT_DIRECTORY-}${GIT_ALTERNATE_OBJECT_DIRECTORIES-}${GIT_COMMON_DIR-}" ]; then
	"$git_bin" rev-list --objects --no-object-names --all "$pending_commit" >"$ci_root/objects" || exit 1
	(
		for git_name in $local_git_env; do unset "$git_name"; done
		"$git_bin" cat-file --batch-check='%(objectname) %(objecttype)' <"$ci_root/objects"
	) >"$ci_root/object-status" || exit 1
	awk '$2 == "missing" { print $1 }' "$ci_root/object-status" >"$ci_root/missing" || exit 1
	"$git_bin" pack-objects --stdout <"$ci_root/missing" >"$ci_root/snapshot.pack" || exit 1
fi

# CI creates temporary repositories and commits in its test fixtures. Do not
# leak the committing worktree's index or Git configuration into those tests.
for git_name in $local_git_env; do
	unset "$git_name"
done
PATH=$caller_path
export PATH
if [ -f "$ci_root/snapshot.pack" ]; then
	"$git_bin" index-pack --stdin <"$ci_root/snapshot.pack" >/dev/null || exit 1
fi
ci_worktree=$ci_root/checkout
"$git_bin" -c core.bare=false worktree add --detach "$ci_worktree" "$pending_commit" || exit 1
# Sparse patterns are inherited by new worktrees. CI must see the full tree;
# sparse-checkout scopes the change to this temporary worktree.
if [ "$("$git_bin" -C "$ci_worktree" config --bool core.sparseCheckout || :)" = true ]; then
	"$git_bin" -C "$ci_worktree" sparse-checkout disable || exit 1
fi
echo "[pre-commit] running full make ci on the staged snapshot"
(cd "$ci_worktree" && make ci)
