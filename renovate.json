{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/test-fixtures/**"
  ],
  "labels": [
    "dependencies"
  ],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Require human review for every dependency update",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false
    },
    {
      "description": "Keep Go module updates tidy for CI and review",
      "matchManagers": [
        "gomod"
      ],
      "postUpdateOptions": [
        "gomodTidy"
      ]
    },
    {
      "description": "Keep Go compatibility and CI toolchain releases aligned",
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "matchDepNames": [
        "go"
      ],
      "groupName": "Go toolchain",
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep VSCE npm dependencies and Marketplace workflow pins aligned",
      "matchManagers": [
        "npm",
        "custom.regex"
      ],
      "matchPackageNames": [
        "@vscode/vsce"
      ],
      "groupName": "VSCE tooling",
      "rangeStrategy": "bump"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Go toolchain used by CI commands",
      "managerFilePatterns": [
        "/(^|/)Makefile$/",
        "/(^|/)scripts/bench-gate\\.sh$/"
      ],
      "matchStrings": [
        "GO_TOOLCHAIN \\?= go(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "GO_TOOLCHAIN=\"go(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update VSCE version checks in the Marketplace release workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/release\\.yml$/"
      ],
      "matchStrings": [
        "if \\[ \"\\$\\{vsce_version\\}\" != \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "Marketplace tooling lockfile must pin @vscode/vsce (?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "jq -e '\\.packages\\[\"node_modules/@vscode/vsce\"\\] \\| \\.version == \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "jq -e '\\.version == \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"' \"\\$\\{toolchain_dir\\}/node_modules/@vscode/vsce/package\\.json\""
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@vscode/vsce",
      "versioningTemplate": "npm"
    }
  ]
}
