{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/test-fixtures/**"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Keep Go module updates tidy for CI and automerge",
      "matchManagers": [
        "gomod"
      ],
      "postUpdateOptions": [
        "gomodTidy"
      ]
    },
    {
      "description": "Keep Go compatibility and CI toolchain releases aligned",
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "matchDepNames": [
        "go"
      ],
      "groupName": "Go toolchain",
      "rangeStrategy": "bump"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Go toolchain used by CI commands",
      "managerFilePatterns": [
        "/(^|/)Makefile$/",
        "/(^|/)scripts/bench-gate\\.sh$/"
      ],
      "matchStrings": [
        "GO_TOOLCHAIN \\?= go(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "GO_TOOLCHAIN=\"go(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "versioningTemplate": "loose"
    }
  ]
}
